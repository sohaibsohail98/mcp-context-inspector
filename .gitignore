# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
# This is a library, not an application — no committed lockfile.
uv.lock

# Session working notes, not a shipped file.
checklist.md
plan.md
CTXWINDOW_LAUNCH_PLAN.md
TODO.md

# Local execution recorder DB / per-user token store — regenerated by
# running the server locally; the token store in particular must never
# be committed (it's real per-user credentials). Matched anywhere in the
# tree, not just the repo root — a local server run can create this
# under mcp_server/data/ too, depending on where METRICS_DB_PATH's
# default resolves to.
#
# NOT ignored: demo/metrics.db — that's the deterministic seed built by
# scripts/seed_demo_db.py, committed on purpose and baked into the image
# (see server.py::_maybe_seed_demo_db). Never point a live server's
# METRICS_DB_PATH at it, or local rows leak into the tracked seed.
data/metrics.db
data/mcp_auth.db
**/data/metrics.db
**/data/mcp_auth.db

# Local env / secrets
.env
.env.*
*.pem

# Wrangler local cache/state — regenerated per machine, not shipped
cloudflare-proxy/.wrangler/

# Demo capture build artefacts (see scripts/demo_capture.py, Makefile's
# demo target). docs/demo.mp4/.gif are now the shipped guided_tour
# takes (see docs/internal/demo-takes.md) and are committed on purpose,
# so only the raw/scratch working directories stay ignored here.
docs/_raw/
# Candidate takes from `make demo-candidates`, kept locally for review
# but never committed; only the one chosen as docs/demo.mp4/.gif ships.
docs/_scratch/
.coverage
